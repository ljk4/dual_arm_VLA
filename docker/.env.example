# Copy to docker/.env, then set the HTTP/mixed port reported by clashctl status.
# Both HTTP_PROXY and HTTPS_PROXY deliberately use the http:// proxy scheme.
# Leave empty when the server can reach all download sites directly.
PROXY_URL=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1

# Use https://huggingface.co if the proxy reaches the official site more reliably.
HF_ENDPOINT=https://hf-mirror.com
CUDA_TOOLKIT_VERSION=12.4.1
MAX_JOBS=2

# System image profile; changing these does not update torch in the Python lock.
BASE_IMAGE=nvidia/cuda:12.4.1-base-ubuntu22.04
ROBOTWIN_IMAGE=dual-arm-vla/robotwin:cu124
